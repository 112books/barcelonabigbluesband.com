{{ define "main" }}
<div class="page-wrap page-wrap--dark"{{ with .Params.bg }} style="--page-bg: url('{{ . | relURL }}')"{{ end }}>
  <div class="page-inner">

    <h1 class="page-title">{{ .Title }}</h1>

    <p class="booking-lead">{{ i18n "booking_lead" }}</p>

    <div class="prose">
      {{ .Content }}
    </div>

    {{ $b := hugo.Data.booking }}

    <!-- ══ EPK ══ -->
    <section class="booking-epk" aria-label="{{ i18n "booking_epk" }}">
      <h2 class="booking-epk__title">{{ i18n "booking_epk" }}</h2>

      <div class="booking-grid">

        <div class="booking-block">
          <h3>{{ i18n "booking_lineup" }}</h3>
          <ul class="booking-lineup" role="list">
            {{ range $b.lineup }}
            <li>
              <strong>{{ .name }}</strong>
              <span>{{ index . (printf "role_%s" $.Lang) | default .role_en }}</span>
            </li>
            {{ end }}
          </ul>
        </div>

        <div class="booking-block">
          <h3>{{ i18n "booking_guests" }}</h3>
          <ul class="booking-guests" role="list">
            {{ range $b.guests }}
            <li>{{ . }}</li>
            {{ end }}
          </ul>
        </div>

        <div class="booking-block">
          <h3>{{ i18n "booking_venues" }}</h3>
          <ul class="booking-venues" role="list">
            {{ range $b.venues }}
            <li>{{ . }}</li>
            {{ end }}
          </ul>
        </div>

        <div class="booking-block">
          <h3>{{ i18n "booking_videos" }}</h3>
          {{ range $b.videos }}
          <div class="booking-video">
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ .id }}"
              title="{{ .title }}"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
          {{ end }}
          <p class="booking-links">
            {{ $mdisc := where $.Site.Menus.main "Identifier" "discography" }}
            {{ range $mdisc }}<a href="{{ .URL }}">{{ i18n "booking_discography_link" }} →</a>{{ end }}
            {{ $mfoto := where $.Site.Menus.main "Identifier" "photos" }}
            {{ range $mfoto }}<a href="{{ .URL }}">{{ i18n "booking_photos_link" }} →</a>{{ end }}
          </p>
        </div>

        <div class="booking-block booking-block--wide">
          <h3>{{ i18n "booking_rider" }}</h3>
          <details class="booking-rider">
            <summary>{{ i18n "booking_rider" }}</summary>
            <ul role="list">
              <li>{{ index $b.rider (printf "formation_%s" $.Lang) | default $b.rider.formation_en }}</li>
              <li>{{ index $b.rider (printf "stage_%s" $.Lang) | default $b.rider.stage_en }}</li>
              <li>{{ index $b.rider (printf "sound_%s" $.Lang) | default $b.rider.sound_en }}</li>
              <li>{{ index $b.rider (printf "backline_%s" $.Lang) | default $b.rider.backline_en }}</li>
              <li>{{ index $b.rider (printf "rehearsal_%s" $.Lang) | default $b.rider.rehearsal_en }}</li>
              <li>{{ index $b.rider (printf "duration_%s" $.Lang) | default $b.rider.duration_en }}</li>
            </ul>
          </details>
        </div>

      </div>
    </section>

    <!-- ══ Contacte + formulari ══ -->
    <section class="booking-contact" aria-label="{{ i18n "booking_contact_title" }}">
      <h2 class="booking-contact__title">{{ i18n "booking_contact_title" }}</h2>

      {{ $endpoint := site.Params.booking_form_endpoint | default "" }}
      <form class="booking-form"
            method="POST"
            action="{{ $endpoint }}"
            data-endpoint="{{ $endpoint }}"
            novalidate>

        {{ $priv := "" }}
        {{ range where site.RegularPages "Params.translationKey" "privacy-policy" }}{{ $priv = .RelPermalink }}{{ end }}

        <input type="hidden" name="form_type" value="booking">

        <div class="booking-form__row">
          <label class="booking-field" for="bk-name">
            <span>{{ i18n "booking_form_name" }} *</span>
            <input type="text" id="bk-name" name="name" required autocomplete="name" aria-describedby="bk-name-err">
            <span class="booking-field__error" id="bk-name-err" role="alert"></span>
          </label>
          <label class="booking-field" for="bk-email">
            <span>{{ i18n "booking_form_email" }} *</span>
            <input type="email" id="bk-email" name="email" required autocomplete="email" aria-describedby="bk-email-err">
            <span class="booking-field__error" id="bk-email-err" role="alert"></span>
          </label>
        </div>

        <div class="booking-form__row">
          <label class="booking-field" for="bk-org">
            <span>{{ i18n "booking_form_org" }}</span>
            <input type="text" id="bk-org" name="organisation" autocomplete="organization">
          </label>
          <label class="booking-field" for="bk-date">
            <span>{{ i18n "booking_form_date" }}</span>
            <input type="date" id="bk-date" name="date">
          </label>
        </div>

        <label class="booking-field" for="bk-message">
          <span>{{ i18n "booking_form_message" }} *</span>
          <textarea id="bk-message" name="message" rows="6" required aria-describedby="bk-message-err"></textarea>
          <span class="booking-field__error" id="bk-message-err" role="alert"></span>
        </label>

        <p class="booking-field__note">{{ i18n "form_privacy_note" }}</p>
        <label class="booking-consent" for="bk-consent">
          <input type="checkbox" id="bk-consent" name="consent" required aria-describedby="bk-consent-err">
          <span>{{ i18n "form_consent" }} <a href="{{ $priv }}" target="_blank" rel="noopener">{{ i18n "privacy_policy" }}</a> *</span>
        </label>
        <span class="booking-field__error" id="bk-consent-err" role="alert"></span>

        {{/* Honeypot anti-spam — invisible per als usuaris reals */}}
        <div class="booking-hp" aria-hidden="true">
          <label>
            <span>{{ i18n "booking_form_honeypot" }}</span>
            <input type="text" name="_hp" tabindex="-1" autocomplete="off">
          </label>
        </div>

        <button type="submit" class="booking-submit">{{ i18n "booking_form_send" }}</button>
        <p class="booking-form__status" role="status" aria-live="polite"></p>
      </form>

      {{ $c := hugo.Data.contact }}
      <div class="booking-mailto">
        <p class="booking-mailto__note">{{ i18n "booking_mailto_note" }}</p>
        <p class="booking-mailto__links">
          <a href="mailto:{{ $c.email }}?subject={{ i18n "booking_contact_title" }}">{{ $c.email }}</a>
          {{ with $c.phone }} · <a href="tel:{{ replace . " " "" }}">{{ . }}</a>{{ end }}
        </p>
      </div>
    </section>

  </div>
</div>

<script>
(function () {
  var form = document.querySelector('.booking-form');
  if (!form) return;
  var status = form.querySelector('.booking-form__status');
  var t = {
    required: '{{ i18n "form_required" }}',
    email: '{{ i18n "form_invalid_email" }}',
    sending: '{{ i18n "form_sending" }}',
    sent: '{{ i18n "form_sent" }}',
    error: '{{ i18n "form_error" }}',
    mailto: '{{ i18n "booking_mailto_note" }}'
  };

  function setError(el, msg) {
    var box = document.getElementById(el.id + '-err');
    if (box) box.textContent = msg || '';
    if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (form.elements['_hp'] && form.elements['_hp'].value) return;

    var ok = true, firstBad = null;
    [['name', t.required], ['email', t.required], ['message', t.required]].forEach(function (f) {
      var el = form.elements[f[0]];
      if (!el) return;
      var msg = '';
      if (!el.value.trim()) msg = f[1];
      else if (el.type === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value.trim())) msg = t.email;
      setError(el, msg);
      if (msg) { ok = false; if (!firstBad) firstBad = el; }
    });
    var consent = form.elements['consent'];
    if (consent && !consent.checked) {
      setError(consent, t.required);
      ok = false; if (!firstBad) firstBad = consent;
    }
    if (!ok) { if (firstBad) firstBad.focus(); return; }

    var endpoint = form.getAttribute('data-endpoint');
    if (!endpoint) {
      var body =
        'Nom: ' + form.elements['name'].value + '\n' +
        'Email: ' + form.elements['email'].value + '\n' +
        'Organització: ' + (form.elements['organisation'].value || '-') + '\n' +
        'Data: ' + (form.elements['date'].value || '-') + '\n\n' +
        form.elements['message'].value;
      window.location.href = 'mailto:{{ $c.email }}?subject=' +
        encodeURIComponent('Contractació — ' + form.elements['name'].value) +
        '&body=' + encodeURIComponent(body);
      if (status) status.textContent = t.mailto;
      return;
    }

    if (status) status.textContent = t.sending;
    fetch(endpoint, { method: 'POST', body: new FormData(form) })
      .then(function (r) {
        if (!r.ok) throw new Error(r.status);
        form.reset();
        if (status) status.textContent = t.sent;
      })
      .catch(function () {
        if (status) status.textContent = t.error;
        window.location.href = 'mailto:{{ $c.email }}?subject=' +
          encodeURIComponent('Contractació') +
          '&body=' + encodeURIComponent(form.elements['message'].value);
      });
  });
})();
</script>
{{ end }}
