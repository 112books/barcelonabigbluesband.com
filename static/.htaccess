RedirectMatch 301 ^/aviso-legal/?$               /es/legal/aviso-legal/
RedirectMatch 301 ^/politica-de-privacidad/?$    /es/legal/politica-privacidad/
RedirectMatch 301 ^/politica-de-cookies/?$       /es/legal/politica-cookies/
RedirectMatch 301 ^/ivan-kovacevic-biografia/?$  /es/biografia/
RedirectMatch 301 ^/proximos-conciretos/?$       /es/proyectos/
RedirectMatch 301 ^/proximos-conciertos/?$       /es/conciertos/
RedirectMatch 301 ^/discografia/?$               /es/discografia/
RedirectMatch 301 ^/videos/?$                    /es/videos/
RedirectMatch 301 ^/contacto/?$                  /es/contacto/
RedirectMatch 301 ^/ivan-kovacevic-sobre-daddario/?$ /es/proyectos/

# EN
RedirectMatch 301 ^/en/next-shows-2/?$ /en/concerts/
RedirectMatch 301 ^/en/gigs/?$          /en/concerts/
RedirectMatch 301 ^/en/next-shows/?$   /en/projects/
RedirectMatch 301 ^/en/videos-2/?$     /en/videos/

# Antics posts de projectes (ES)
RedirectMatch 301 ^/2018/05/0[79]/lazy-jumpers/?$                     /es/proyectos/lazy-jumpers/
RedirectMatch 301 ^/2018/05/0[79]/nu-niles/?$                         /es/proyectos/the-nu-niles/
RedirectMatch 301 ^/2018/05/0[79]/the-nu-niles/?$                     /es/proyectos/the-nu-niles/
