# ── Errors ────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Redireccions ──────────────────────────────────────────
RedirectMatch 301 ^/admin/?$ /ca/admin/

# ── Redireccions des de l'antic WordPress ─────────────────
