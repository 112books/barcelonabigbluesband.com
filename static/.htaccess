RedirectMatch 301 ^/2018/05/0[79]/los-mambo-jambo/?$                  /es/proyectos/los-mambo-jambo/
RedirectMatch 301 ^/2018/05/0[79]/barcelona-big-blues-band/?$         /es/proyectos/barcelona-big-blues-band/
RedirectMatch 301 ^/2018/05/0[79]/barcelona-gipsy-[a-z]+-orchestra/?$ /es/proyectos/barcelona-gipsy-balkan-orchestra/
RedirectMatch 301 ^/2018/05/0[79]/ivan-kovacevic-5-spots/?$           /es/proyectos/5-spots/
RedirectMatch 301 ^/2018/05/0[79]/down-home/?$                        /es/proyectos/down-home/

# Antics posts de projectes (EN)
RedirectMatch 301 ^/en/2018/05/0[79]/the-nu-niles/?$                     /en/projects/the-nu-niles/
RedirectMatch 301 ^/en/2018/05/0[79]/bernat-font-trio/?$                 /en/projects/bernat-font-trio/
RedirectMatch 301 ^/en/2018/05/0[79]/los-mambo-jambo/?$                  /en/projects/los-mambo-jambo/
RedirectMatch 301 ^/en/2018/05/0[79]/barcelona-big-blues-band/?$         /en/projects/barcelona-big-blues-band/
RedirectMatch 301 ^/en/2018/05/0[79]/barcelona-gipsy-[a-z]+-orchestra/?$ /en/projects/barcelona-gipsy-balkan-orchestra/
RedirectMatch 301 ^/en/2018/05/0[79]/ivan-kovacevic-5-spots/?$           /en/projects/5-spots/
RedirectMatch 301 ^/en/2018/05/0[79]/lazy-jumpers/?$                     /en/projects/lazy-jumpers/

# Posts antics → notícies (secció eliminada: redirigim a inici/pressa)
RedirectMatch 301 ^/2018/05/10/268x0w/?$ /es/
RedirectMatch 301 ^/2018/05/10/ruta-66-meeting-point-ivan-kovacevic/?$ /es/prensa/
RedirectMatch 301 ^/2018/05/11/avo-kanto-balkan-tour/?$ /es/proyectos/barcelona-gipsy-balkan-orchestra/
RedirectMatch 301 ^/2021/04/21/bratia/?$ /es/proyectos/bratia/

# Posts EN antics amb sufix -2
RedirectMatch 301 ^/en/2018/05/0[79]/bernat-font-trio-2/?$ /en/projects/bernat-font-trio/
RedirectMatch 301 ^/en/2018/05/0[79]/barcelona-big-blues-band-2/?$ /en/projects/barcelona-big-blues-band/
RedirectMatch 301 ^/en/2018/05/0[79]/los-mambo-jambo-2/?$ /en/projects/los-mambo-jambo/
