# ── Errors ────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Redireccions ──────────────────────────────────────────
RedirectMatch 301 ^/admin/?$ /ca/admin/

# Arrel → home catalana (abans servia una còpia de /ca/ amb 200)
RedirectMatch 301 ^/?$ /ca/

# ── Redireccions des de l'antic WordPress ─────────────────
# ES (URLs antigues a l'arrel)
RedirectMatch 301 ^/aviso-legal/?$                    /es/aviso-legal/
RedirectMatch 301 ^/politica-de-privacidad/?$         /es/privacidad/
RedirectMatch 301 ^/politica-de-cookies/?$            /es/cookies/
RedirectMatch 301 ^/ivan-kovacevic-biografia/?$       /es/biografia/
RedirectMatch 301 ^/ivan-kovacevic-sobre-daddario/?$  /es/biografia/
RedirectMatch 301 ^/proximos-conciretos/?$            /es/agenda/
RedirectMatch 301 ^/proximos-conciertos/?$            /es/agenda/
RedirectMatch 301 ^/discografia/?$                    /es/discografia/
RedirectMatch 301 ^/videos/?$                         /es/videos/
RedirectMatch 301 ^/contacto/?$                       /es/contacto/

# URLS antigues que encara reben clics a Search Console (26/11/2026)
RedirectMatch 301 ^/en/shows(/.*)?$    /en/agenda/
RedirectMatch 301 ^/en/events(/.*)?$   /en/agenda/
RedirectMatch 301 ^/biografia/?$       /ca/biografia/
RedirectMatch 301 ^/videos-2/?$        /ca/videos/
RedirectMatch 301 ^/noticias/?$        /ca/premsa/
RedirectMatch 301 ^/ca/noticias/?$     /ca/premsa/

# EN
RedirectMatch 301 ^/en/next-shows-2/?$  /en/agenda/
RedirectMatch 301 ^/en/next-shows/?$    /en/agenda/
RedirectMatch 301 ^/en/gigs/?$          /en/agenda/
RedirectMatch 301 ^/en/videos-2/?$      /en/videos/

# Posts antics: URLs específiques primer (guanyen per ordre)
RedirectMatch 301 ^/2018/05/10/ruta-66-meeting-point-ivan-kovacevic/?$  /es/prensa/
RedirectMatch 301 ^/2018/05/10/268x0w/?$                                /es/

# Posts antics de projectes → biografia (la secció "projectes" ja no existeix)
RedirectMatch 301 ^/2018/05/0[0-9]/[A-Za-z0-9-]+/?$        /es/biografia/
RedirectMatch 301 ^/2018/05/10/[A-Za-z0-9-]+/?$            /es/biografia/
RedirectMatch 301 ^/2021/04/21/[A-Za-z0-9-]+/?$            /es/biografia/
RedirectMatch 301 ^/en/2018/05/0[0-9]/[A-Za-z0-9-]+/?$     /en/biography/

# Esdeveniments antics (The Events Calendar) → agenda
RedirectMatch 301 ^/events(/.*)?$  /es/agenda/
RedirectMatch 301 ^/event(/.*)?$   /es/agenda/

# Categories i etiquetes antigues
RedirectMatch 301 ^/category/proyectos(/.*)?$    /es/biografia/
RedirectMatch 301 ^/category/slide-es/?$         /es/biografia/
RedirectMatch 301 ^/category/noticias/?$         /es/prensa/
RedirectMatch 301 ^/category/en-los-medios/?$    /es/prensa/
RedirectMatch 301 ^/category(/.*)?$              /es/
RedirectMatch 301 ^/en/category/projects(/.*)?$  /en/biography/
RedirectMatch 301 ^/en/category/slide/?$         /en/biography/
RedirectMatch 301 ^/en/category(/.*)?$           /en/
RedirectMatch 301 ^/tag(/.*)?$                   /es/prensa/

# Sitemap i feeds antics
RedirectMatch 301 ^/sitemap_index\.xml$  /sitemap.xml
RedirectMatch 301 ^/wp-sitemap\.xml$     /sitemap.xml
RedirectMatch 301 ^/feed/?$               /es/
RedirectMatch 301 ^/comments/feed/?$      /es/

# ── WordPress llegat: endpoints inexistents (410 Gone) ────
RedirectMatch 410 ^/wp-admin(/.*)?$
RedirectMatch 410 ^/wp-login\.php$
RedirectMatch 410 ^/xmlrpc\.php$
RedirectMatch 410 ^/wp-json(/.*)?$
RedirectMatch 410 ^/wp-cron\.php$
RedirectMatch 410 ^/wp-includes(/.*)?$
RedirectMatch 410 ^/wp-content(/.*)?$
RedirectMatch 410 ^/author(/.*)?$

# ── Seguretat: Headers HTTP ───────────────────────────────
<IfModule mod_headers.c>
    # HSTS: força HTTPS durant 1 any (preload per a la llista de navegadors)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Evita clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Evita MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # COOP
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # CSP — sense 'unsafe-inline' a script-src (tot el JS és extern).
    # connect-src inclou el comptador GoatCounter propi (beacons de gc.zgo.at/count.js).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://gc.zgo.at https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' https://unpkg.com; img-src 'self' data: https:; connect-src 'self' https://gc.zgo.at https://barcelonabigbluesband.goatcounter.com https://api.github.com https://raw.githubusercontent.com https://cms-oauth-bratia-y855.vercel.app https://unpkg.com; frame-src https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Compressió ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Caché estàtica ─────────────────────────────────────────
<IfModule mod_headers.c>
    # Imatges i fonts: caché immutable 1 any
    <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/svg+xml     "access plus 1 year"
    ExpiresByType text/css          "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2        "access plus 1 year"
</IfModule>
